msgstr "Shift+F9"

#: formsettings.rfastautohidepopup_hint
msgctxt "formsettings.rfastautohidepopup_hint"
msgid "Automatically hide the popup window when you click anywhere outside of it"
msgstr "Tự động ẩn cửa sổ bật lên khi bạn nhấp vào bất kỳ đâu bên ngoài cửa sổ"

